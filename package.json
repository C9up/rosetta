{
  "name": "@c9up/rosetta",
  "version": "0.1.4",
  "description": "Rosetta — dedicated i18n module for the Ream ecosystem",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.*.node",
    "scripts",
    "src",
    "wasm"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/RosettaProvider.ts",
      "import": "./src/RosettaProvider.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:rust": "cargo build --release",
    "build:napi": "cargo build --release && node scripts/copy-napi.mjs",
    "test": "vitest run",
    "test:rust": "cargo test",
    "test:napi": "node scripts/verify-napi.mjs",
    "lint": "biome check src/ tests/",
    "build:wasm": "wasm-pack build --target web crates/rosetta-engine-wasm --out-dir ../../wasm",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/RosettaProvider.d.ts",
        "import": "./dist/RosettaProvider.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/rosetta.git"
  }
}
