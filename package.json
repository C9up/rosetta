{
  "name": "@c9up/rosetta",
  "version": "0.3.2",
  "description": "Rosetta \u2014 dedicated i18n module for the Ream ecosystem",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "benchmarks",
    "dist",
    "scripts",
    "src",
    "stubs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.browser.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/RosettaProvider.ts",
      "import": "./src/RosettaProvider.ts"
    },
    "./factories": {
      "types": "./src/factories/main.ts",
      "import": "./src/factories/main.ts"
    },
    "./i18n_provider": {
      "types": "./src/RosettaProvider.ts",
      "import": "./src/RosettaProvider.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "import": "./src/middleware.ts"
    },
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    },
    "./plugins/inker": {
      "types": "./src/plugins/inker.ts",
      "import": "./src/plugins/inker.ts"
    },
    "./repl": {
      "types": "./src/repl.ts",
      "import": "./src/repl.ts"
    },
    "./types": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:browser": "tsc -p tsconfig.build.json && node scripts/verify-browser.mjs",
    "bench": "node benchmarks/rosetta.mjs",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json && node scripts/verify-browser.mjs && node scripts/verify-package.mjs",
    "test:types": "tsc --noEmit -p tsconfig.types.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22.19.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "@c9up/ream": "^0.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/index.browser.js",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/RosettaProvider.d.ts",
        "import": "./dist/RosettaProvider.js"
      },
      "./factories": {
        "types": "./dist/factories/main.d.ts",
        "import": "./dist/factories/main.js"
      },
      "./i18n_provider": {
        "types": "./dist/RosettaProvider.d.ts",
        "import": "./dist/RosettaProvider.js"
      },
      "./middleware": {
        "types": "./dist/middleware.d.ts",
        "import": "./dist/middleware.js"
      },
      "./configure": {
        "types": "./dist/configure.d.ts",
        "import": "./dist/configure.js"
      },
      "./plugins/inker": {
        "types": "./dist/plugins/inker.d.ts",
        "import": "./dist/plugins/inker.js"
      },
      "./repl": {
        "types": "./dist/repl.d.ts",
        "import": "./dist/repl.js"
      },
      "./types": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/rosetta.git"
  },
  "peerDependencies": {
    "@c9up/ream": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": { "optional": true }
  }
}
